#!/usr/bin/env bash
# SSH 免密登录一键配置/清除脚本
# 用法: ssh-setup-key <IP> [密钥或密码] [user] [port] [alias]
#       ssh-setup-key clear <IP|alias> [密钥或密码] [user] [port] [alias]
#   密钥或密码: 传文件路径(已存在的私钥)用密钥登录, 否则当密码用密码登录
#   alias: 可选 SSH 别名；默认不设置。也可用 --alias/-a 指定。

set -u -o pipefail

usage() {
    echo "用法:"
    echo "  添加: $0 <IP> [密钥或密码] [user] [port] [alias]"
    echo "        $0 <IP> [密钥或密码] [user] [port] --alias <alias>"
    echo "        $0 <IP> --ask-pass [user] [port] --alias <alias>"
    echo "        $0 <IP> --password-stdin [user] [port] --alias <alias>"
    echo "  清除: $0 clear <IP|alias> [密钥或密码] [user] [port] [alias]"
    echo "        $0 clear <IP> [密钥或密码] --alias <alias>"
    echo "        $0 --clear <IP|alias> [密钥或密码] [options]"
    echo ""
    echo "  <密钥或密码>:"
    echo "    传文件路径 → 用该私钥登录（目标机器仅密钥认证时）"
    echo "    传字符串   → 当作密码用 sshpass 登录"
    echo "    未传入     → 交互选择输入密码或私钥路径"
    echo "  --ask-pass      交互输入密码，适合包含 !、$、&、引号等特殊字符的密码"
    echo "  --password-stdin 从标准输入读取一行密码"
    echo "  --key <path>    明确指定登录私钥"
    echo "  --password <s>  明确指定登录密码"
    echo "  --user <user>   明确指定 SSH 用户"
    echo "  --port <port>   明确指定 SSH 端口"
    echo "  [user] 默认 root"
    echo "  [port] 默认 22"
    echo "  [alias] 默认不设置；填写后写入 ~/.ssh/config，可用 ssh <alias> 登录"
    echo "  省略密钥或密码时，如需指定非默认用户/端口，请使用 --user/--port"
    echo "  --clear/clear 清除指定 IP/别名相关的本机/远端指纹和 SSH 配置"
    echo "  清除模式的参数顺序和添加模式一致：IP 后第一个普通参数是密钥或密码"
    echo "  清除模式可省略密钥或密码；默认用户 root，默认端口 22，远端清理会交互询问认证信息"
    echo "  清除模式如只想指定非默认用户/端口且不传凭据，请使用 --user/--port"
    echo "  通过别名清除时，脚本会读取 ~/.ssh/config 中的 HostName/User/Port"
    echo "  清除模式远端不可达或认证失败时，仅保留本机清理结果并跳过远端清理"
    echo "  --local-only 仅清理本机 known_hosts/config，不连接远端"
    echo "  清除不会删除本机 ~/.ssh/id_ed25519 私钥对"
    echo "  远端 authorized_keys 只删除本脚本写入的本机公钥，不会清空其它公钥"
    echo ""
    echo "示例:"
    echo "  $0 192.168.1.100 mypassword"
    echo "  $0 192.168.1.100 -a testbox"
    echo "  $0 192.168.1.100 --ask-pass root 22 -a testbox"
    echo "  printf '%s\\n' 'my!pa\$\$&word' | $0 192.168.1.100 --password-stdin root 22 -a testbox"
    echo "  $0 192.168.1.100 ~/.ssh/old_key"
    echo "  $0 192.168.1.100 ~/.ssh/old_key wangmeng 6000"
    echo "  $0 192.168.1.100 ~/.ssh/old_key wangmeng 6000 spark-002"
    echo "  $0 192.168.1.100 mypassword --alias testbox"
    echo "  $0 clear testbox"
    echo "  $0 clear 192.168.1.100 -a testbox"
    echo "  $0 clear 192.168.1.100 mypassword -a testbox"
    echo "  $0 clear 192.168.1.100 ~/.ssh/old_key root 22 -a testbox"
    echo "  $0 clear 192.168.1.100 --user root --port 22 -a testbox --local-only"
    echo "  $0 --clear 192.168.1.100 --password 'mypassword' --user root --port 22 -a testbox"
}

fail_step() {
    local step="$1"
    local hint="$2"
    echo "[✗] 失败步骤: ${step}" >&2
    echo "    处理建议: ${hint}" >&2
    exit 1
}

show_ssh_config() {
    if [[ -z "${SSH_ALIAS:-}" ]]; then
        return 0
    fi

    local SSH_CONFIG="$HOME/.ssh/config"
    echo "──────────────────────────────"
    echo "SSH config 内容: ${SSH_CONFIG}"
    if [[ -f "$SSH_CONFIG" ]]; then
        echo "----- BEGIN ~/.ssh/config -----"
        cat "$SSH_CONFIG"
        echo "----- END ~/.ssh/config -----"
    else
        echo "(未写入 ~/.ssh/config；请检查别名写入步骤是否成功)"
    fi
    echo "──────────────────────────────"
}

shell_quote() {
    local value
    value=${1//\'/\'\\\'\'}
    printf "'%s'" "$value"
}

safe_cmd() {
    local quoted=()
    local arg
    for arg in "$@"; do
        quoted+=("$(shell_quote "$arg")")
    done
    printf '%s' "${quoted[*]}"
}

read_password_prompt() {
    local prompt="${1:-SSH 密码: }"
    local password
    if [[ ! -t 0 ]]; then
        fail_step "读取密码" "--ask-pass 需要交互式终端；非交互环境请改用 --password-stdin。"
    fi
    printf '%s' "$prompt" >&2
    IFS= read -r -s password || fail_step "读取密码" "无法从终端读取密码，请确认当前会话支持交互输入。"
    printf '\n' >&2
    printf '%s' "$password"
}

read_password_stdin() {
    local password
    IFS= read -r password || fail_step "读取标准输入密码" "请通过标准输入传入一行密码，例如: printf '%s\\n' '<密码>' | $0 <IP> --password-stdin。"
    printf '%s' "$password"
}

expand_auth_path() {
    local auth_path="$1"
    case "$auth_path" in
        "~") auth_path="$HOME" ;;
        ~/*) auth_path="${HOME}/${auth_path#~/}" ;;
    esac
    printf '%s' "$auth_path"
}

read_auth_interactive() {
    local choice key_path

    if [[ ! -t 0 ]]; then
        fail_step "读取认证信息" "未提供密码或私钥且当前不是交互式终端；请传入 <密码或私钥路径>、--ask-pass、--password-stdin 或 --key。"
    fi

    echo "[*] 未提供登录密码或私钥，进入手动输入模式" >&2
    while true; do
        printf '请选择认证方式 [1=密码, 2=私钥路径] (默认 1): ' >&2
        IFS= read -r choice || fail_step "读取认证方式" "无法从终端读取输入，请确认当前会话支持交互输入。"
        case "$choice" in
            ""|1|p|P|password|Password|"密码")
                if ! AUTH_PASS="$(read_password_prompt "SSH 密码: ")"; then
                    exit 1
                fi
                AUTH_MODE="password"
                AUTH_SET=1
                AUTH_EXPLICIT=1
                return 0
                ;;
            2|k|K|key|Key|"密钥"|"秘钥"|"私钥")
                printf '私钥路径: ' >&2
                IFS= read -r key_path || fail_step "读取私钥路径" "无法从终端读取输入，请确认当前会话支持交互输入。"
                key_path="$(expand_auth_path "$key_path")"
                if [[ -z "$key_path" ]]; then
                    echo "[!] 私钥路径不能为空，请重新选择" >&2
                    continue
                fi
                AUTH_KEY="$key_path"
                AUTH_MODE="key"
                AUTH_SET=1
                AUTH_EXPLICIT=1
                return 0
                ;;
            *)
                echo "[!] 无效选择，请输入 1 或 2" >&2
                ;;
        esac
    done
}

find_identity_file_for_host() {
    local host="$1"
    local identity
    if [[ -n "$host" ]] && command -v ssh &>/dev/null; then
        identity="$(ssh -G "$host" 2>/dev/null | awk 'tolower($1) == "identityfile" && $2 !~ /_sk$/ { print $2; exit }')" || true
        if [[ -n "$identity" ]]; then
            case "$identity" in
                ~/*) identity="${HOME}/${identity#~/}" ;;
            esac
            if [[ -f "$identity" ]]; then
                printf '%s\n' "$identity"
                return 0
            fi
        fi
    fi
    return 1
}

ssh_config_has_exact_host() {
    local host="$1"
    local config_file="$HOME/.ssh/config"

    [[ -f "$config_file" ]] || return 1
    awk -v target="$host" '
        tolower($1) == "host" {
            for (i = 2; i <= NF; i++) {
                if ($i == target) {
                    found = 1
                }
            }
        }
        END { exit(found ? 0 : 1) }
    ' "$config_file"
}

ssh_config_value() {
    local host="$1"
    local key="$2"

    ssh -G "$host" 2>/dev/null | awk -v target_key="$key" '
        tolower($1) == target_key {
            $1 = ""
            sub(/^[[:space:]]+/, "")
            print
            exit
        }
    '
}

apply_clear_config_defaults() {
    local target="$1"
    local lookup_host=""
    local config_hostname config_user config_port config_identity

    if [[ -n "$SSH_ALIAS" ]] && ssh_config_has_exact_host "$SSH_ALIAS"; then
        lookup_host="$SSH_ALIAS"
    elif ssh_config_has_exact_host "$target"; then
        lookup_host="$target"
        if [[ -z "$SSH_ALIAS" ]]; then
            SSH_ALIAS="$target"
        fi
    fi

    [[ -n "$lookup_host" ]] || return 0

    config_hostname="$(ssh_config_value "$lookup_host" hostname)"
    config_user="$(ssh_config_value "$lookup_host" user)"
    config_port="$(ssh_config_value "$lookup_host" port)"

    if [[ -n "$config_hostname" && ( "$IP" == "$target" || "$IP" == "$SSH_ALIAS" ) ]]; then
        IP="$config_hostname"
    fi
    if [[ "$USER_SET" -eq 0 && -n "$config_user" ]]; then
        USER="$config_user"
    fi
    if [[ "$PORT_SET" -eq 0 && -n "$config_port" ]]; then
        PORT="$config_port"
    fi
    if [[ "$AUTH_SET" -eq 0 ]] && config_identity="$(find_identity_file_for_host "$lookup_host")"; then
        AUTH="$config_identity"
        AUTH_MODE="key"
        AUTH_KEY="$config_identity"
        AUTH_SET=1
    fi
}

collect_ssh_config_target_hosts() {
    local config_file="$1"
    local target_host="$2"
    local target_port="$3"
    local target_alias="$4"

    if [[ ! -f "$config_file" ]]; then
        return 0
    fi

    awk -v target="$target_host" -v port="$target_port" -v alias="$target_alias" '
        function is_direct(name) {
            return name == target || name == "[" target "]:" port || (alias != "" && name == alias)
        }
        function is_wild(name) {
            return name ~ /[*?]/ || substr(name, 1, 1) == "!"
        }
        function add(name) {
            if (name != "" && !is_wild(name) && !(name in seen)) {
                seen[name] = 1
                print name
            }
        }
        function flush_block(    i) {
            if (in_host && (host_direct_match || (hostname_match && !has_wild))) {
                for (i = 1; i <= host_count; i++) {
                    add(host_name[i])
                }
            }
        }
        $1 == "Host" {
            flush_block()
            in_host = 1
            host_count = 0
            host_direct_match = 0
            hostname_match = 0
            has_wild = 0
            for (i = 2; i <= NF; i++) {
                host_name[++host_count] = $i
                if (is_direct($i)) {
                    host_direct_match = 1
                }
                if (is_wild($i)) {
                    has_wild = 1
                }
            }
            next
        }
        in_host && tolower($1) == "hostname" && $2 == target {
            hostname_match = 1
        }
        END {
            flush_block()
        }
    ' "$config_file"
}

remove_ssh_config_target() {
    local config_file="$1"
    local target_host="$2"
    local target_port="$3"
    local target_alias="$4"
    local label="$5"
    local tmp_config

    if [[ ! -f "$config_file" ]]; then
        echo "[*] ${label}: 未找到 ${config_file}，跳过"
        return 0
    fi

    tmp_config="$(mktemp)" || fail_step "创建临时 config 文件" "请检查 /tmp 是否可写，以及磁盘空间是否充足: df -h /tmp。"
    awk -v target="$target_host" -v port="$target_port" -v alias="$target_alias" '
        function is_direct(name) {
            return name == target || name == "[" target "]:" port || (alias != "" && name == alias)
        }
        function is_wild(name) {
            return name ~ /[*?]/ || substr(name, 1, 1) == "!"
        }
        function flush_block() {
            if (!in_host) {
                printf "%s", block
            } else if (!(host_direct_match || (hostname_match && !has_wild))) {
                printf "%s", block
            }
        }
        $1 == "Host" {
            flush_block()
            block = $0 ORS
            in_host = 1
            host_direct_match = 0
            hostname_match = 0
            has_wild = 0
            for (i = 2; i <= NF; i++) {
                if (is_direct($i)) {
                    host_direct_match = 1
                }
                if (is_wild($i)) {
                    has_wild = 1
                }
            }
            next
        }
        {
            if (!in_host) {
                print
                next
            }
            block = block $0 ORS
            if (tolower($1) == "hostname" && $2 == target) {
                hostname_match = 1
            }
        }
        END {
            flush_block()
        }
    ' "$config_file" > "$tmp_config" || fail_step "清理 ${label} config" "请检查 '$config_file' 是否可读写、语法是否正常。"

    if cmp -s "$config_file" "$tmp_config"; then
        rm -f "$tmp_config"
        echo "[*] ${label}: config 中未找到指向 $target_host 的 Host 块"
        return 0
    fi

    if [[ -s "$tmp_config" ]]; then
        mv "$tmp_config" "$config_file" || fail_step "写回 ${label} config" "请检查 '$config_file' 是否可写。"
        chmod 600 "$config_file" || fail_step "设置 ${label} config 权限" "请执行 chmod 600 '$config_file' 后重试。"
    else
        rm -f "$config_file" "$tmp_config" || fail_step "删除空 ${label} config" "请检查 '$config_file' 是否可写。"
    fi
    echo "[✓] ${label}: 已清除指向 $target_host 的 Host 配置"
}

remove_known_hosts_entries() {
    local known_hosts_file="$1"
    shift

    if [[ ! -f "$known_hosts_file" ]]; then
        echo "[*] 本机: 未找到 ${known_hosts_file}，跳过"
        return 0
    fi

    local tmp_file line_numbers hosts_text host
    tmp_file="$(mktemp)" || fail_step "创建临时 known_hosts 文件" "请检查 /tmp 是否可写，以及磁盘空间是否充足: df -h /tmp。"

    if command -v ssh-keygen &>/dev/null; then
        line_numbers="$(
            for host in "$@"; do
                [[ -n "$host" ]] || continue
                ssh-keygen -F "$host" -f "$known_hosts_file" 2>/dev/null | awk '/^# Host .* found: line [0-9]+[[:space:]]*$/ { print $(NF - 0) }'
            done | sort -n -u | tr '\n' ' '
        )"

        if [[ -z "$line_numbers" ]]; then
            rm -f "$tmp_file"
            echo "[*] 本机: $known_hosts_file 中未找到目标指纹"
            return 0
        fi

        awk -v lines="$line_numbers" '
            BEGIN {
                n = split(lines, line, /[[:space:]]+/)
                for (i = 1; i <= n; i++) {
                    if (line[i] != "") {
                        remove[line[i]] = 1
                    }
                }
            }
            !(NR in remove) { print }
        ' "$known_hosts_file" > "$tmp_file" || fail_step "清理本机 known_hosts" "请检查 '$known_hosts_file' 是否可读写。"
    else
        hosts_text="$(printf '%s\034' "$@")"
        awk -v hosts="$hosts_text" '
            BEGIN {
                n = split(hosts, host, "\034")
                for (i = 1; i <= n; i++) {
                    if (host[i] != "") {
                        remove_host[host[i]] = 1
                    }
                }
            }
            {
                host_field = $1
                if (substr($1, 1, 1) == "@") {
                    host_field = $2
                }
                keep = 1
                split(host_field, patterns, ",")
                for (i in patterns) {
                    if (patterns[i] in remove_host) {
                        keep = 0
                    }
                }
                if (keep) {
                    print
                }
            }
        ' "$known_hosts_file" > "$tmp_file" || fail_step "清理本机 known_hosts" "请检查 '$known_hosts_file' 是否可读写。"

        if cmp -s "$known_hosts_file" "$tmp_file"; then
            rm -f "$tmp_file"
            echo "[*] 本机: $known_hosts_file 中未找到目标指纹"
            return 0
        fi
    fi

    if [[ -s "$tmp_file" ]]; then
        mv "$tmp_file" "$known_hosts_file" || fail_step "写回本机 known_hosts" "请检查 '$known_hosts_file' 是否可写。"
        chmod 600 "$known_hosts_file" 2>/dev/null || true
    else
        rm -f "$known_hosts_file" "$tmp_file" || fail_step "删除空本机 known_hosts" "请检查 '$known_hosts_file' 是否可写。"
    fi
    echo "[✓] 本机: 已清除 $known_hosts_file 中的目标指纹"
}

load_local_public_key() {
    if [[ -f "${SSH_KEY}.pub" ]]; then
        cat "${SSH_KEY}.pub"
        return 0
    fi
    if [[ -f "$SSH_KEY" ]]; then
        ssh-keygen -y -f "$SSH_KEY"
        return $?
    fi
    return 1
}

clear_remote_ssh_state() {
    local pub_key="$1"
    local remote_cmd
    local ssh_options=(
        -o StrictHostKeyChecking=no
        -o UserKnownHostsFile=/dev/null
        -o LogLevel=ERROR
        -o ConnectTimeout=10
    )

    if [[ "$AUTH_MODE" != "password" ]]; then
        ssh_options+=(-o BatchMode=yes)
    fi

    remote_cmd="PUB_KEY=$(shell_quote "$pub_key") TARGET_HOST=$(shell_quote "$IP") TARGET_PORT=$(shell_quote "$PORT") TARGET_ALIAS=$(shell_quote "$SSH_ALIAS") sh -s"

    ssh_cmd "${ssh_options[@]}" -p "$PORT" "$SSH_TARGET" "$remote_cmd" <<'REMOTE_CLEAN'
ssh_dir="${HOME}/.ssh"

