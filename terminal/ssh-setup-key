positional_field_available() {
    case "$1" in
        auth) [[ "$AUTH_SET" -eq 0 ]] ;;
        user) [[ "$USER_SET" -eq 0 ]] ;;
        port) [[ "$PORT_SET" -eq 0 ]] ;;
        *) return 1 ;;
    esac
}

positional_field_score() {
    local field="$1"
    local value="$2"
    local expanded

    case "$field" in
        auth)
            expanded="$(expand_auth_path "$value")"
            if [[ -f "$expanded" ]]; then
                printf '%s' 8
            elif looks_like_path "$value"; then
                printf '%s' 6
            elif is_port_value "$value"; then
                printf '%s' 1
            elif is_username_value "$value"; then
                printf '%s' 3
            else
                printf '%s' 7
            fi
            ;;
        user)
            is_username_value "$value" || return 1
            printf '%s' 3
            ;;
        port)
            is_port_value "$value" || return 1
            printf '%s' 5
            ;;
        *)
            return 1
            ;;
    esac
}

add_positional_candidate() {
    CAND_AUTH_USED+=("$1")
    CAND_AUTH_VALUE+=("$2")
    CAND_USER_USED+=("$3")
    CAND_USER_VALUE+=("$4")
    CAND_PORT_USED+=("$5")
    CAND_PORT_VALUE+=("$6")
    CAND_SCORE+=("$7")
}

walk_positional_candidates() {
    local idx="$1"
    local stage="$2"
    local auth_used="$3"
    local auth_value="$4"
    local user_used="$5"
    local user_value="$6"
    local port_used="$7"
    local port_value="$8"
    local score="$9"
    local argc="${#POSITIONAL[@]}"
    local fields=(auth user port)
    local field token field_score next_score f

    if (( idx == argc )); then
        add_positional_candidate "$auth_used" "$auth_value" "$user_used" "$user_value" "$port_used" "$port_value" "$score"
        return 0
    fi

    token="${POSITIONAL[$idx]}"
    for (( f = stage; f < 3; f++ )); do
        field="${fields[$f]}"
        positional_field_available "$field" || continue
        if ! field_score="$(positional_field_score "$field" "$token")"; then
            continue
        fi
        next_score=$(( score + field_score ))
        case "$field" in
            auth)
                walk_positional_candidates "$((idx + 1))" "$((f + 1))" 1 "$token" "$user_used" "$user_value" "$port_used" "$port_value" "$next_score"
                ;;
            user)
                walk_positional_candidates "$((idx + 1))" "$((f + 1))" "$auth_used" "$auth_value" 1 "$token" "$port_used" "$port_value" "$next_score"
                ;;
            port)
                walk_positional_candidates "$((idx + 1))" "$((f + 1))" "$auth_used" "$auth_value" "$user_used" "$user_value" 1 "$token" "$next_score"
                ;;
        esac
    done
}

candidate_summary() {
    local idx="$1"
    local auth_text user_text port_text expanded

    if [[ "${CAND_AUTH_USED[$idx]}" -eq 1 ]]; then
        expanded="$(expand_auth_path "${CAND_AUTH_VALUE[$idx]}")"
        if [[ -f "$expanded" ]]; then
            auth_text="私钥:$expanded"
        else
            auth_text="密码/字符串(已提供)"
        fi
    elif [[ "$AUTH_SET" -eq 1 ]]; then
        auth_text="已通过选项提供"
    else
        auth_text="稍后交互输入"
    fi

    if [[ "${CAND_USER_USED[$idx]}" -eq 1 ]]; then
        user_text="${CAND_USER_VALUE[$idx]}"
    else
        user_text="$USER"
    fi

    if [[ "${CAND_PORT_USED[$idx]}" -eq 1 ]]; then
        port_text="${CAND_PORT_VALUE[$idx]}"
    else
        port_text="$PORT"
    fi

    printf '凭据=%s, 用户=%s, 端口=%s' "$auth_text" "$user_text" "$port_text"
}

apply_positional_candidate() {
    local idx="$1"

    if [[ "${CAND_AUTH_USED[$idx]}" -eq 1 ]]; then
        set_auth_from_value "${CAND_AUTH_VALUE[$idx]}"
    fi
    if [[ "${CAND_USER_USED[$idx]}" -eq 1 ]]; then
        USER="${CAND_USER_VALUE[$idx]}"
        USER_SET=1
    fi
    if [[ "${CAND_PORT_USED[$idx]}" -eq 1 ]]; then
        PORT="${CAND_PORT_VALUE[$idx]}"
        PORT_SET=1
    fi
}

classify_positionals() {
    local available_slots=0
    local best_score=-1
    local best_indices=()
    local i choice selected last_index

    [[ "$AUTH_SET" -eq 0 ]] && available_slots=$((available_slots + 1))
    [[ "$USER_SET" -eq 0 ]] && available_slots=$((available_slots + 1))
    [[ "$PORT_SET" -eq 0 ]] && available_slots=$((available_slots + 1))

    if [[ ${#POSITIONAL[@]} -gt "$available_slots" && -z "$SSH_ALIAS" ]]; then
        last_index=$((${#POSITIONAL[@]} - 1))
        SSH_ALIAS="${POSITIONAL[$last_index]}"
        unset "POSITIONAL[$last_index]"
    fi

    if [[ ${#POSITIONAL[@]} -gt "$available_slots" ]]; then
        echo "[✗] 位置参数过多: ${POSITIONAL[*]}"
        usage
        exit 1
    fi

    if [[ ${#POSITIONAL[@]} -eq 0 ]]; then
        return 0
    fi

    CAND_AUTH_USED=()
    CAND_AUTH_VALUE=()
    CAND_USER_USED=()
    CAND_USER_VALUE=()
    CAND_PORT_USED=()
    CAND_PORT_VALUE=()
    CAND_SCORE=()

    walk_positional_candidates 0 0 0 "" 0 "" 0 "" 0

    if [[ ${#CAND_SCORE[@]} -eq 0 ]]; then
        echo "[✗] 无法识别位置参数: ${POSITIONAL[*]}"
        echo "    规则: 密码/私钥在用户名前，用户名不以数字开头，端口为 1-65535 的数字。"
        exit 1
    fi

    for i in "${!CAND_SCORE[@]}"; do
        if (( CAND_SCORE[$i] > best_score )); then
            best_score="${CAND_SCORE[$i]}"
            best_indices=("$i")
        elif (( CAND_SCORE[$i] == best_score )); then
            best_indices+=("$i")
        fi
    done

    if [[ ${#best_indices[@]} -eq 1 ]]; then
        apply_positional_candidate "${best_indices[0]}"
        return 0
    fi

    if [[ ! -t 0 ]]; then
        echo "[✗] 位置参数存在歧义，且当前不是交互式终端: ${POSITIONAL[*]}"
        echo "    请使用 --password/--key/--user/--port 明确指定。"
        exit 1
    fi

    echo "[?] 位置参数存在歧义，请选择解析方式:" >&2
    for i in "${!best_indices[@]}"; do
        printf '  %d) %s\n' "$((i + 1))" "$(candidate_summary "${best_indices[$i]}")" >&2
    done
    while true; do
        printf '请选择 [1-%d] (默认 1): ' "${#best_indices[@]}" >&2
        IFS= read -r choice || fail_step "读取参数解析选择" "无法从终端读取输入，请改用 --password/--key/--user/--port 明确指定。"
        choice="${choice:-1}"
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#best_indices[@]} )); then
            selected="${best_indices[$((choice - 1))]}"
            apply_positional_candidate "$selected"
            return 0
        fi
        echo "[!] 无效选择，请输入 1 到 ${#best_indices[@]} 之间的数字" >&2
    done
}

CLEAR_MODE=0
if [[ $# -gt 0 && ( "$1" == "--clear" || "$1" == "-c" || "$1" == "clear" ) ]]; then
    CLEAR_MODE=1
    shift
fi

if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
    usage
    exit 0
fi

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

IP=""
AUTH=""
USER="root"
PORT="22"
SSH_ALIAS=""
AUTH_SET=0
AUTH_EXPLICIT=0
AUTH_MODE=""
AUTH_KEY=""
AUTH_PASS=""
USER_SET=0
PORT_SET=0
LOCAL_ONLY=0
SSH_KEY="$HOME/.ssh/id_ed25519"

# 普通参数按顺序为：凭据、用户、端口；任一项可省略。
# 类型可消除歧义时自动识别；简单字符串同时可能是密码和用户名时交互询问。
# 仍保留凭据/用户/端口之后的第 4 个普通参数作为 SSH 别名以兼容旧用法。
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--alias)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "[✗] --alias 需要提供非空别名"
                exit 1
            fi
            SSH_ALIAS="$2"
            shift 2
            ;;
        --alias=*)
            SSH_ALIAS="${1#--alias=}"
            if [[ -z "$SSH_ALIAS" ]]; then
                echo "[✗] --alias 需要提供非空别名"
                exit 1
            fi
            shift
            ;;
        -u|--user)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "[✗] --user 需要提供非空用户名"
                exit 1
            fi
            USER="$2"
            USER_SET=1
            shift 2
            ;;
        --user=*)
            USER="${1#--user=}"
            if [[ -z "$USER" ]]; then
                echo "[✗] --user 需要提供非空用户名"
                exit 1
            fi
            USER_SET=1
            shift
            ;;
        -p|--port)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "[✗] --port 需要提供端口"
                exit 1
            fi
            PORT="$2"
            PORT_SET=1
            shift 2
            ;;
        --port=*)
            PORT="${1#--port=}"
            if [[ -z "$PORT" ]]; then
                echo "[✗] --port 需要提供端口"
                exit 1
            fi
            PORT_SET=1
            shift
            ;;
        --ask-pass)
            if ! AUTH_PASS="$(read_password_prompt "SSH 密码: ")"; then
                exit 1
            fi
            AUTH_MODE="password"
            AUTH_SET=1
            AUTH_EXPLICIT=1
            shift
            ;;
        --password-stdin)
            if ! AUTH_PASS="$(read_password_stdin)"; then
                exit 1
            fi
            AUTH_MODE="password"
            AUTH_SET=1
            AUTH_EXPLICIT=1
            shift
            ;;
        --password)
            if [[ $# -lt 2 ]]; then
                echo "[✗] --password 需要提供密码"
                exit 1
            fi
            AUTH_PASS="$2"
            AUTH_MODE="password"
            AUTH_SET=1
            AUTH_EXPLICIT=1
            shift 2
            ;;
        --password=*)
            AUTH_PASS="${1#--password=}"
            AUTH_MODE="password"
            AUTH_SET=1
            AUTH_EXPLICIT=1
            shift
            ;;
        --key)
            if [[ $# -lt 2 || -z "${2:-}" ]]; then
                echo "[✗] --key 需要提供私钥路径"
                exit 1
            fi
            AUTH_KEY="$(expand_auth_path "$2")"
            AUTH_MODE="key"
            AUTH_SET=1
            AUTH_EXPLICIT=1
            shift 2
            ;;
        --key=*)
            AUTH_KEY="$(expand_auth_path "${1#--key=}")"
            if [[ -z "$AUTH_KEY" ]]; then
                echo "[✗] --key 需要提供私钥路径"
                exit 1
            fi
            AUTH_MODE="key"
            AUTH_SET=1
            AUTH_EXPLICIT=1
            shift
            ;;
        --local-only)
            LOCAL_ONLY=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -c|--clear|clear)
            CLEAR_MODE=1
            shift
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

if [[ "$CLEAR_MODE" -eq 0 ]]; then
    if [[ ${#POSITIONAL[@]} -lt 1 ]]; then
        usage
        exit 1
    fi
    IP="${POSITIONAL[0]}"
    POSITIONAL=("${POSITIONAL[@]:1}")
else
    if [[ ${#POSITIONAL[@]} -ge 1 ]]; then
        IP="${POSITIONAL[0]}"
        POSITIONAL=("${POSITIONAL[@]:1}")
    elif [[ -n "$SSH_ALIAS" ]]; then
        IP="$SSH_ALIAS"
    else
        usage
        exit 1
    fi
fi

classify_positionals

if [[ "$CLEAR_MODE" -eq 1 ]]; then
    if [[ -z "$SSH_ALIAS" && "$IP" != *.* && "$IP" != *:* ]]; then
        SSH_ALIAS="$IP"
    fi
    apply_clear_config_defaults "$IP"
fi

if [[ ! "$PORT" =~ ^[0-9]+$ ]]; then
    echo "[✗] 端口必须是数字: $PORT"
    exit 1
fi
if (( PORT < 1 || PORT > 65535 )); then
    echo "[✗] 端口超出范围: $PORT (有效范围 1-65535)"
    exit 1
fi
if [[ -n "$SSH_ALIAS" ]]; then
    if [[ "$SSH_ALIAS" =~ [[:space:]] || "$SSH_ALIAS" == -* ]]; then
        echo "[✗] SSH 别名不能包含空白字符，也不能以 - 开头: $SSH_ALIAS"
        exit 1
    fi
fi

SSH_TARGET="${USER}@${IP}"

# 判断认证方式: AUTH 是已存在的文件 → 密钥登录, 否则 → 密码登录
if [[ "$CLEAR_MODE" -eq 0 && "$AUTH_SET" -eq 0 ]]; then
    read_auth_interactive
elif [[ "$AUTH_MODE" == "key" ]]; then
    if [[ ! -f "$AUTH_KEY" ]]; then
        echo "[✗] 指定的私钥文件不存在: $AUTH_KEY"
        exit 1
    fi
    chmod 600 "$AUTH_KEY" || fail_step "设置登录私钥权限" "请检查本机文件权限/所有者: ls -l '$AUTH_KEY'；必要时执行 sudo chown \"$(id -un)\" '$AUTH_KEY' 后重试。"
    echo "[✓] 已设置登录私钥权限为 600: $AUTH_KEY"
elif [[ "$AUTH_MODE" == "password" ]]; then
    :
elif [[ "$AUTH_SET" -eq 1 && -f "$AUTH" ]]; then
    AUTH_MODE="key"
    AUTH_KEY="$AUTH"
    chmod 600 "$AUTH_KEY" || fail_step "设置登录私钥权限" "请检查本机文件权限/所有者: ls -l '$AUTH_KEY'；必要时执行 sudo chown \"$(id -un)\" '$AUTH_KEY' 后重试。"
    echo "[✓] 已设置登录私钥权限为 600: $AUTH_KEY"
elif [[ "$AUTH_SET" -eq 1 ]]; then
    AUTH_MODE="password"
    AUTH_PASS="$AUTH"
elif [[ "$CLEAR_MODE" -eq 1 ]]; then
    if [[ "$AUTH_SET" -eq 0 ]]; then
        if [[ -f "$SSH_KEY" ]]; then
            AUTH_MODE="key"
            AUTH_KEY="$SSH_KEY"
            AUTH_SET=1
        else
            AUTH_MODE="default"
        fi
    fi
else
    usage
    exit 1
fi

SSH_TARGET="${USER}@${IP}"

echo "[*] 目标: ${USER}@${IP}:${PORT} (认证: ${AUTH_MODE})"
if [[ -n "$SSH_ALIAS" ]]; then
    echo "[*] SSH 别名: ${SSH_ALIAS}"
fi
if [[ "$CLEAR_MODE" -eq 1 ]]; then
    echo "[*] 模式: 清除"
else
    echo "[*] 模式: 添加"
fi

# 前置检查: sshpass（密码模式且需要连接远端时才需要）
if [[ "$AUTH_MODE" == "password" && ( "$CLEAR_MODE" -eq 0 || "$LOCAL_ONLY" -eq 0 ) ]] && ! command -v sshpass &>/dev/null; then
    echo "[*] 安装 sshpass ..."
    if ! (apt-get install -y sshpass &>/dev/null 2>&1 || yum install -y sshpass &>/dev/null 2>&1); then
        fail_step "安装 sshpass" "请先手动安装 sshpass：Debian/Ubuntu 用 apt-get install -y sshpass；RHEL/CentOS 用 yum install -y sshpass。"
    fi
fi

# SSH 命令封装: 根据认证模式拼参数
ssh_cmd() {
    if [[ "$AUTH_MODE" == "key" ]]; then
        ssh -i "$AUTH_KEY" "$@"
    elif [[ "$AUTH_MODE" == "password" ]]; then
        sshpass -d 3 ssh "$@" 3<<< "$AUTH_PASS"
    else
        ssh "$@"
    fi
}

ssh_copy_id_cmd() {
    if [[ "$AUTH_MODE" == "key" ]]; then
        # 用已有私钥登录后追加新公钥
        local PUB_KEY
        PUB_KEY="$(cat "${SSH_KEY}.pub")" || return 1
        ssh -i "$AUTH_KEY" -o StrictHostKeyChecking=no -p "$PORT" "$SSH_TARGET" "$(safe_cmd sh -c "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && grep -qxF -- \"\$1\" ~/.ssh/authorized_keys || printf '%s\n' \"\$1\" >> ~/.ssh/authorized_keys" sh "$PUB_KEY")"
    elif [[ "$AUTH_MODE" == "password" ]]; then
        sshpass -d 3 ssh-copy-id -o StrictHostKeyChecking=no -i "${SSH_KEY}.pub" \
            -p "$PORT" "$SSH_TARGET" 3<<< "$AUTH_PASS"
    else
        ssh-copy-id -o StrictHostKeyChecking=no -i "${SSH_KEY}.pub" -p "$PORT" "$SSH_TARGET"
    fi
}

if [[ "$CLEAR_MODE" -eq 1 ]]; then
    clear_ssh_state
    exit 0
fi

configure_ssh_alias() {
    if [[ -z "$SSH_ALIAS" ]]; then
        return 0
    fi

    local SSH_DIR SSH_CONFIG TMP_CONFIG
    SSH_DIR="$HOME/.ssh"
    SSH_CONFIG="$SSH_DIR/config"
    TMP_CONFIG="$(mktemp)" || fail_step "创建临时 config 文件" "请检查 /tmp 是否可写，以及磁盘空间是否充足: df -h /tmp。"

    mkdir -p "$SSH_DIR" || fail_step "创建本机 ~/.ssh 目录" "请检查 HOME 是否正确、目录是否可写: echo \${HOME}; ls -ld \${HOME}。"
    chmod 700 "$SSH_DIR" || fail_step "设置本机 ~/.ssh 权限" "请检查目录所有者: ls -ld '$SSH_DIR'；必要时执行 sudo chown -R \"$(id -un)\" '$SSH_DIR'。"

    if [[ -f "$SSH_CONFIG" ]]; then
        cp -a "$SSH_CONFIG" "${SSH_CONFIG}.bak.$(date +%Y%m%d-%H%M%S)" || fail_step "备份 ~/.ssh/config" "请检查 '$SSH_CONFIG' 是否可读写、磁盘空间是否充足。"
        awk -v alias="$SSH_ALIAS" '
            $1 == "Host" {
                skip = 0
                for (i = 2; i <= NF; i++) {
                    if ($i == alias) {
                        skip = 1
                        break
                    }
                }
            }
            !skip { print }
        ' "$SSH_CONFIG" > "$TMP_CONFIG" || fail_step "更新 ~/.ssh/config 中的 Host 块" "请检查 config 语法和文件权限；可先从备份恢复 ~/.ssh/config.bak.*。"
    else
        : > "$TMP_CONFIG" || fail_step "初始化临时 config" "请检查 /tmp 是否可写。"
    fi

    {
        cat "$TMP_CONFIG"
        if [[ -s "$TMP_CONFIG" ]]; then
            printf '\n'
        fi
        printf 'Host %s\n' "$SSH_ALIAS"
        printf '    HostName %s\n' "$IP"
        printf '    User %s\n' "$USER"
        printf '    Port %s\n' "$PORT"
        printf '    IdentityFile %s\n' "$SSH_KEY"
        printf '    IdentitiesOnly yes\n'
    } > "$SSH_CONFIG" || fail_step "写入 ~/.ssh/config" "请检查 '$SSH_DIR' 是否可写、磁盘空间是否充足；如已有损坏配置可从 ~/.ssh/config.bak.* 恢复。"

    rm -f "$TMP_CONFIG"
    chmod 600 "$SSH_CONFIG" || fail_step "设置 ~/.ssh/config 权限" "请执行 chmod 600 '$SSH_CONFIG' 后重试，或检查文件所有者是否为当前用户。"
    echo "[✓] SSH 别名已写入: $SSH_CONFIG (Host $SSH_ALIAS)"
}

# 生成密钥（如不存在）
if [[ ! -f "$SSH_KEY" ]]; then
    echo "[*] 生成 SSH 密钥对 ..."
    mkdir -p "$HOME/.ssh" || fail_step "创建本机 ~/.ssh 目录" "请检查 HOME 是否正确、目录是否可写: echo \${HOME}; ls -ld \${HOME}。"
    chmod 700 "$HOME/.ssh" || fail_step "设置本机 ~/.ssh 目录权限" "请执行 chmod 700 '$HOME/.ssh'，并确认目录所有者为当前用户。"
    ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -C "AK" -q || fail_step "生成本机 SSH 密钥" "请检查 ssh-keygen 是否存在、'$HOME/.ssh' 是否可写；可手动执行 ssh-keygen -t ed25519 -f '$SSH_KEY' -N ''."
    chmod 600 "$SSH_KEY" || fail_step "设置本机私钥权限" "请执行 chmod 600 '$SSH_KEY' 后重试。"
    [[ -f "${SSH_KEY}.pub" ]] && chmod 644 "${SSH_KEY}.pub"
    echo "[✓] 密钥已生成: $SSH_KEY"
else
    chmod 600 "$SSH_KEY" || fail_step "设置本机私钥权限" "请检查文件所有者: ls -l '$SSH_KEY'；必要时执行 sudo chown \"$(id -un)\" '$SSH_KEY' 后重试。"
    [[ -f "${SSH_KEY}.pub" ]] && chmod 644 "${SSH_KEY}.pub"
    echo "[✓] 密钥已存在并已设置权限 600: $SSH_KEY"
fi

if [[ ! -f "${SSH_KEY}.pub" ]]; then
    ssh-keygen -y -f "$SSH_KEY" > "${SSH_KEY}.pub" || fail_step "补生成本机公钥" "请确认 '$SSH_KEY' 是有效私钥；可手动执行 ssh-keygen -y -f '$SSH_KEY' > '${SSH_KEY}.pub'。"
    chmod 644 "${SSH_KEY}.pub"
fi

echo "[*] 清理本机旧 SSH 主机指纹 ..."
clean_local_known_hosts_for_target

# 检查是否已经免密
if ssh -o BatchMode=yes -o ConnectTimeout=5 -p "$PORT" "$SSH_TARGET" "exit 0" &>/dev/null; then
    echo "[✓] 免密登录已生效，无需重复配置"
    configure_ssh_alias
    if [[ -n "$SSH_ALIAS" ]]; then
        echo "  别名 : ssh $SSH_ALIAS"
    fi
    show_ssh_config
    exit 0
fi

# 配置远端 ~/.ssh 目录权限
echo "[*] 配置远端 SSH 目录 ..."
    if ! ssh_cmd -o StrictHostKeyChecking=no -o ConnectTimeout=10 -p "$PORT" "$SSH_TARGET" \
        "mkdir -p ~/.ssh && chmod 700 ~/.ssh"; then
    if [[ "$AUTH_MODE" == "key" ]]; then
        fail_step "连接远端并配置 ~/.ssh 目录" "请检查 IP/端口/用户/私钥是否正确：ssh -i '$AUTH_KEY' -p '$PORT' '$SSH_TARGET'；如提示 bad permissions，确认本机私钥为 600。"
    else
        fail_step "连接远端并配置 ~/.ssh 目录" "请检查 IP/端口/用户/密码是否正确；特殊字符密码请改用 --ask-pass 或 --password-stdin；也确认远端允许 PasswordAuthentication。"
    fi
fi

# 推送公钥
echo "[*] 推送公钥到 ${SSH_TARGET} ..."
if ! ssh_copy_id_cmd; then
    if [[ "$AUTH_MODE" == "key" ]]; then
        fail_step "推送公钥" "请确认现有登录私钥可写入远端 ~/.ssh/authorized_keys；可手动执行 ssh -i '$AUTH_KEY' -p '$PORT' '$SSH_TARGET' 后检查 ~/.ssh 目录权限和磁盘空间。"
    else
        fail_step "推送公钥" "请确认密码正确、远端允许密码登录且 ssh-copy-id 可用；可手动执行 ssh-copy-id -i '${SSH_KEY}.pub' -p '$PORT' '$SSH_TARGET'。"
    fi
fi

# 验证
echo "[*] 验证免密登录 ..."
if ssh -o BatchMode=yes -o ConnectTimeout=5 -p "$PORT" "$SSH_TARGET" \
    "echo '[✓] 免密登录验证成功'"; then
    configure_ssh_alias
    echo "──────────────────────────────"
    echo "  IP   : $IP"
    echo "  用户 : $USER"
    echo "  端口 : $PORT"
    echo "  认证 : ${AUTH_MODE}"
    echo "  连接 : ssh -p $PORT $SSH_TARGET"
    if [[ -n "$SSH_ALIAS" ]]; then
        echo "  别名 : ssh $SSH_ALIAS"
    fi
    echo "──────────────────────────────"
    show_ssh_config
else
    fail_step "验证免密登录" "公钥可能未正确写入远端 authorized_keys，或远端 sshd 禁止 PubkeyAuthentication。请检查远端 ~/.ssh 权限为 700、~/.ssh/authorized_keys 权限为 600，并查看 /var/log/auth.log 或 journalctl -u ssh/sshd。"
fi
