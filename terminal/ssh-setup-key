configure_ssh_alias() {
    if [[ -z "$SSH_ALIAS" ]]; then
        return 0
    fi

    local SSH_DIR SSH_CONFIG TMP_CONFIG
    SSH_DIR="$HOME/.ssh"
    SSH_CONFIG="$SSH_DIR/config"
    TMP_CONFIG="$(mktemp)" || fail_step "创建临时 config 文件" "请检查 /tmp 是否可写，以及磁盘空间是否充足: df -h /tmp。"

    mkdir -p "$SSH_DIR" || fail_step "创建本机 ~/.ssh 目录" "请检查 HOME 是否正确、目录是否可写: echo \${HOME}; ls -ld \${HOME}。"
    chmod 700 "$SSH_DIR" || fail_step "设置本机 ~/.ssh 权限" "请检查目录所有者: ls -ld '$SSH_DIR'；必要时执行 sudo chown -R \"$(id -un)\" '$SSH_DIR'。"

    if [[ -f "$SSH_CONFIG" ]]; then
        cp -a "$SSH_CONFIG" "${SSH_CONFIG}.bak.$(date +%Y%m%d-%H%M%S)" || fail_step "备份 ~/.ssh/config" "请检查 '$SSH_CONFIG' 是否可读写、磁盘空间是否充足。"
        awk -v alias="$SSH_ALIAS" '
            $1 == "Host" {
                skip = 0
                for (i = 2; i <= NF; i++) {
                    if ($i == alias) {
                        skip = 1
                        break
                    }
                }
            }
            !skip { print }
        ' "$SSH_CONFIG" > "$TMP_CONFIG" || fail_step "更新 ~/.ssh/config 中的 Host 块" "请检查 config 语法和文件权限；可先从备份恢复 ~/.ssh/config.bak.*。"
    else
        : > "$TMP_CONFIG" || fail_step "初始化临时 config" "请检查 /tmp 是否可写。"
    fi

    {
        cat "$TMP_CONFIG"
        if [[ -s "$TMP_CONFIG" ]]; then
            printf '\n'
        fi
        printf 'Host %s\n' "$SSH_ALIAS"
        printf '    HostName %s\n' "$IP"
        printf '    User %s\n' "$USER"
        printf '    Port %s\n' "$PORT"
        printf '    IdentityFile %s\n' "$SSH_KEY"
        printf '    IdentitiesOnly yes\n'
    } > "$SSH_CONFIG" || fail_step "写入 ~/.ssh/config" "请检查 '$SSH_DIR' 是否可写、磁盘空间是否充足；如已有损坏配置可从 ~/.ssh/config.bak.* 恢复。"

    rm -f "$TMP_CONFIG"
    chmod 600 "$SSH_CONFIG" || fail_step "设置 ~/.ssh/config 权限" "请执行 chmod 600 '$SSH_CONFIG' 后重试，或检查文件所有者是否为当前用户。"
    echo "[✓] SSH 别名已写入: $SSH_CONFIG (Host $SSH_ALIAS)"
}

# 生成密钥（如不存在）
if [[ ! -f "$SSH_KEY" ]]; then
    echo "[*] 生成 SSH 密钥对 ..."
    mkdir -p "$HOME/.ssh" || fail_step "创建本机 ~/.ssh 目录" "请检查 HOME 是否正确、目录是否可写: echo \${HOME}; ls -ld \${HOME}。"
    chmod 700 "$HOME/.ssh" || fail_step "设置本机 ~/.ssh 目录权限" "请执行 chmod 700 '$HOME/.ssh'，并确认目录所有者为当前用户。"
    ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -C "AK" -q || fail_step "生成本机 SSH 密钥" "请检查 ssh-keygen 是否存在、'$HOME/.ssh' 是否可写；可手动执行 ssh-keygen -t ed25519 -f '$SSH_KEY' -N ''."
    chmod 600 "$SSH_KEY" || fail_step "设置本机私钥权限" "请执行 chmod 600 '$SSH_KEY' 后重试。"
    [[ -f "${SSH_KEY}.pub" ]] && chmod 644 "${SSH_KEY}.pub"
    echo "[✓] 密钥已生成: $SSH_KEY"
else
    chmod 600 "$SSH_KEY" || fail_step "设置本机私钥权限" "请检查文件所有者: ls -l '$SSH_KEY'；必要时执行 sudo chown \"$(id -un)\" '$SSH_KEY' 后重试。"
    [[ -f "${SSH_KEY}.pub" ]] && chmod 644 "${SSH_KEY}.pub"
    echo "[✓] 密钥已存在并已设置权限 600: $SSH_KEY"
fi

