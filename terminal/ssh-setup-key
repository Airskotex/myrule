clear_ssh_state() {
    local pub_key=""
    local known_hosts_targets=("$IP" "[$IP]:$PORT")
    local ssh_dir="$HOME/.ssh"
    local remote_result="未执行"

    if [[ -n "$SSH_ALIAS" ]]; then
        known_hosts_targets+=("$SSH_ALIAS" "[$SSH_ALIAS]:$PORT")
    fi

    if pub_key="$(load_local_public_key 2>/dev/null)"; then
        :
    else
        pub_key=""
        echo "[*] 本机: 未找到 $SSH_KEY 或 ${SSH_KEY}.pub，跳过远端 authorized_keys 公钥清理"
    fi

    echo "[*] 清理本机 SSH 状态 ..."
    mkdir -p "$ssh_dir" || fail_step "创建本机 ~/.ssh 目录" "请检查 HOME 是否正确、目录是否可写: echo \${HOME}; ls -ld \${HOME}。"
    chmod 700 "$ssh_dir" || fail_step "设置本机 ~/.ssh 目录权限" "请执行 chmod 700 '$ssh_dir'，并确认目录所有者为当前用户。"

    if [[ -f "$ssh_dir/config" ]]; then
        while IFS= read -r config_host; do
            [[ -n "$config_host" ]] || continue
            known_hosts_targets+=("$config_host" "[$config_host]:$PORT")
        done < <(collect_ssh_config_target_hosts "$ssh_dir/config" "$IP" "$PORT" "$SSH_ALIAS")
    fi

    remove_known_hosts_entries "$ssh_dir/known_hosts" "${known_hosts_targets[@]}"
    remove_known_hosts_entries "$ssh_dir/known_hosts2" "${known_hosts_targets[@]}"
    remove_ssh_config_target "$ssh_dir/config" "$IP" "$PORT" "$SSH_ALIAS" "本机"

    if [[ "$LOCAL_ONLY" -eq 1 ]]; then
        remote_result="已跳过 (--local-only)"
        echo "[*] 远端: --local-only 已指定，跳过远端 SSH 状态清理"
    else
        echo "[*] 清理远端 SSH 状态 ..."
        if clear_remote_ssh_state "$pub_key"; then
            remote_result="已清理"
            echo "[✓] 远端: 已清理指定 IP 相关的 known_hosts/config，并移除本脚本公钥"
        else
            remote_result="已跳过 (远端不可达或认证失败)"
            echo "[!] 远端: 连接或认证失败，已跳过远端清理；本机 known_hosts/config 已按目标清理" >&2
        fi
    fi

    echo "──────────────────────────────"
    echo "  已清除: $SSH_TARGET:$PORT"
    if [[ -n "$SSH_ALIAS" ]]; then
        echo "  别名  : $SSH_ALIAS"
    fi
    echo "  远端  : $remote_result"
    echo "  范围  : 仅指定 IP 相关的远端 authorized_keys/known_hosts/config；本机 known_hosts/config"
    echo "  保留  : 本机 $SSH_KEY 私钥对"
    echo "──────────────────────────────"
}

clean_local_known_hosts_for_target() {
    local ssh_dir="$HOME/.ssh"
    local known_hosts_targets=("$IP" "[$IP]:$PORT")
    local config_host

    if [[ -n "$SSH_ALIAS" ]]; then
        known_hosts_targets+=("$SSH_ALIAS" "[$SSH_ALIAS]:$PORT")
    fi

    if [[ -f "$ssh_dir/config" ]]; then
        while IFS= read -r config_host; do
            [[ -n "$config_host" ]] || continue
            known_hosts_targets+=("$config_host" "[$config_host]:$PORT")
        done < <(collect_ssh_config_target_hosts "$ssh_dir/config" "$IP" "$PORT" "$SSH_ALIAS")
    fi

    remove_known_hosts_entries "$ssh_dir/known_hosts" "${known_hosts_targets[@]}"
    remove_known_hosts_entries "$ssh_dir/known_hosts2" "${known_hosts_targets[@]}"
}

