remove_remote_config_target() {
    file="$1"
    alias="$2"
    target="$3"
    port="$4"
    [ -f "$file" ] || return 0

    tmp="${file}.tmp.$$"
    awk -v target="$target" -v port="$port" -v alias="$alias" '
        function is_direct(name) {
            return name == target || name == "[" target "]:" port || (alias != "" && name == alias)
        }
        function is_wild(name) {
            return name ~ /[*?]/ || substr(name, 1, 1) == "!"
        }
        function flush_block() {
            if (!in_host) {
                printf "%s", block
            } else if (!(host_direct_match || (hostname_match && !has_wild))) {
                printf "%s", block
            }
        }
        $1 == "Host" {
            flush_block()
            block = $0 ORS
            in_host = 1
            host_direct_match = 0
            hostname_match = 0
            has_wild = 0
            for (i = 2; i <= NF; i++) {
                if (is_direct($i)) {
                    host_direct_match = 1
                }
                if (is_wild($i)) {
                    has_wild = 1
                }
            }
            next
        }
        {
            if (!in_host) {
                print
                next
            }
            block = block $0 ORS
            if (tolower($1) == "hostname" && $2 == target) {
                hostname_match = 1
            }
        }
        END {
            flush_block()
        }
    ' "$file" > "$tmp" || {
        rm -f "$tmp"
        return 1
    }

