            if (tolower($1) == "hostname" && $2 == target) {
                hostname_match = 1
            }
        }
        END {
            flush_block()
        }
    ' "$file" > "$tmp" || {
        rm -f "$tmp"
        return 1
    }

    if cmp -s "$file" "$tmp"; then
        rm -f "$tmp"
        return 0
    fi
    if [ -s "$tmp" ]; then
        mv "$tmp" "$file" || return 1
        chmod 600 "$file" 2>/dev/null || true
    else
        rm -f "$file" "$tmp" || return 1
    fi
}

remove_remote_known_hosts() {
    file="$1"
    shift
    [ -f "$file" ] || return 0

    tmp="${file}.tmp.$$"
    if command -v ssh-keygen >/dev/null 2>&1; then
        lines="$(
            for host in "$@"; do
                [ -n "$host" ] || continue
                ssh-keygen -F "$host" -f "$file" 2>/dev/null | awk '/^# Host .* found: line [0-9]+[[:space:]]*$/ { print $(NF - 0) }'
            done | sort -n -u | tr '\n' ' '
        )"
        if [ -z "$lines" ]; then
            rm -f "$tmp"
            return 0
        fi
        awk -v lines="$lines" '
            BEGIN {
                n = split(lines, line, /[[:space:]]+/)
                for (i = 1; i <= n; i++) {
                    if (line[i] != "") {
                        remove[line[i]] = 1
                    }
                }
            }
            !(NR in remove) { print }
        ' "$file" > "$tmp" || {
            rm -f "$tmp"
            return 1
        }
    else
        hosts_text="$(printf '%s\034' "$@")"
        awk -v hosts="$hosts_text" '
            BEGIN {
                n = split(hosts, host, "\034")
                for (i = 1; i <= n; i++) {
                    if (host[i] != "") {
                        remove_host[host[i]] = 1
                    }
                }
            }
            {
                host_field = $1
                if (substr($1, 1, 1) == "@") {
                    host_field = $2
                }
                keep = 1
                split(host_field, patterns, ",")
                for (i in patterns) {
                    if (patterns[i] in remove_host) {
                        keep = 0
                    }
                }
                if (keep) {
                    print
                }
            }
        ' "$file" > "$tmp" || {
            rm -f "$tmp"
            return 1
        }
        if cmp -s "$file" "$tmp"; then
            rm -f "$tmp"
            return 0
        fi
    fi

    if [ -s "$tmp" ]; then
        mv "$tmp" "$file" || return 1
        chmod 600 "$file" 2>/dev/null || true
    else
        rm -f "$file" "$tmp" || return 1
    fi
}

if [ -d "$ssh_dir" ]; then
    config_hosts=""
    if [ -f "$ssh_dir/config" ]; then
        config_hosts="$(collect_remote_config_hosts "$ssh_dir/config" "$TARGET_ALIAS" "$TARGET_HOST" "$TARGET_PORT")" || exit 1
