ssh_copy_id_cmd() {
    if [[ "$AUTH_MODE" == "key" ]]; then
        # 用已有私钥登录后追加新公钥
        local PUB_KEY
        PUB_KEY="$(cat "${SSH_KEY}.pub")" || return 1
        ssh -i "$AUTH_KEY" -o StrictHostKeyChecking=no -p "$PORT" "$SSH_TARGET" "$(safe_cmd sh -c "mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && grep -qxF -- \"\$1\" ~/.ssh/authorized_keys || printf '%s\n' \"\$1\" >> ~/.ssh/authorized_keys" sh "$PUB_KEY")"
    elif [[ "$AUTH_MODE" == "password" ]]; then
        sshpass -d 3 ssh-copy-id -o StrictHostKeyChecking=no -i "${SSH_KEY}.pub" \
            -p "$PORT" "$SSH_TARGET" 3<<< "$AUTH_PASS"
    else
        ssh-copy-id -o StrictHostKeyChecking=no -i "${SSH_KEY}.pub" -p "$PORT" "$SSH_TARGET"
    fi
}

