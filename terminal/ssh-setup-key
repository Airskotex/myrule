echo "[*] 清理本机旧 SSH 主机指纹 ..."
clean_local_known_hosts_for_target

# 检查是否已经免密
if ssh -o BatchMode=yes -o ConnectTimeout=5 -p "$PORT" "$SSH_TARGET" "exit 0" &>/dev/null; then
    echo "[✓] 免密登录已生效，无需重复配置"
    configure_ssh_alias
    if [[ -n "$SSH_ALIAS" ]]; then
        echo "  别名 : ssh $SSH_ALIAS"
    fi
    show_ssh_config
    exit 0
fi

# 配置远端 ~/.ssh 目录权限
echo "[*] 配置远端 SSH 目录 ..."
    if ! ssh_cmd -o StrictHostKeyChecking=no -o ConnectTimeout=10 -p "$PORT" "$SSH_TARGET" \
        "mkdir -p ~/.ssh && chmod 700 ~/.ssh"; then
    if [[ "$AUTH_MODE" == "key" ]]; then
        fail_step "连接远端并配置 ~/.ssh 目录" "请检查 IP/端口/用户/私钥是否正确：ssh -i '$AUTH_KEY' -p '$PORT' '$SSH_TARGET'；如提示 bad permissions，确认本机私钥为 600。"
    else
        fail_step "连接远端并配置 ~/.ssh 目录" "请检查 IP/端口/用户/密码是否正确；特殊字符密码请改用 --ask-pass 或 --password-stdin；也确认远端允许 PasswordAuthentication。"
    fi
fi

# 推送公钥
echo "[*] 推送公钥到 ${SSH_TARGET} ..."
if ! ssh_copy_id_cmd; then
    if [[ "$AUTH_MODE" == "key" ]]; then
        fail_step "推送公钥" "请确认现有登录私钥可写入远端 ~/.ssh/authorized_keys；可手动执行 ssh -i '$AUTH_KEY' -p '$PORT' '$SSH_TARGET' 后检查 ~/.ssh 目录权限和磁盘空间。"
    else
        fail_step "推送公钥" "请确认密码正确、远端允许密码登录且 ssh-copy-id 可用；可手动执行 ssh-copy-id -i '${SSH_KEY}.pub' -p '$PORT' '$SSH_TARGET'。"
    fi
fi

# 验证
echo "[*] 验证免密登录 ..."
if ssh -o BatchMode=yes -o ConnectTimeout=5 -p "$PORT" "$SSH_TARGET" \
    "echo '[✓] 免密登录验证成功'"; then
    configure_ssh_alias
    echo "──────────────────────────────"
    echo "  IP   : $IP"
    echo "  用户 : $USER"
    echo "  端口 : $PORT"
    echo "  认证 : ${AUTH_MODE}"
    echo "  连接 : ssh -p $PORT $SSH_TARGET"
    if [[ -n "$SSH_ALIAS" ]]; then
        echo "  别名 : ssh $SSH_ALIAS"
    fi
    echo "──────────────────────────────"
    show_ssh_config
else
    fail_step "验证免密登录" "公钥可能未正确写入远端 authorized_keys，或远端 sshd 禁止 PubkeyAuthentication。请检查远端 ~/.ssh 权限为 700、~/.ssh/authorized_keys 权限为 600，并查看 /var/log/auth.log 或 journalctl -u ssh/sshd。"
fi
